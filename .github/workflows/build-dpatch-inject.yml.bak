name: Build DPatch Injected APK
on:
  workflow_dispatch: {}
env:
  OFFICIAL_URL: https://cloud.dsdog.tk/d/google/temp/%E7%95%AA%E8%8C%84%E5%85%8D%E8%B4%B9%E5%B0%8F%E8%AF%B4_7.2.4.32.apk?sign=xUavME2Rt4Vf1FTbCppPq7sU8bRUFh29hrbIhdsXon4=:0
  MODDED_URL: https://github.com/callacat/gha-build-farm/releases/download/apk-assets/fanqie_novel_7.2.4.19.apk
jobs:
  inject:
    runs-on: ubuntu-22.04
    timeout-minutes: 15
    steps:
      - uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Install apktool
        run: |
          curl -sL "https://github.com/iBotPeaches/Apktool/releases/download/v3.0.2/apktool_3.0.2.jar" -o /opt/apktool.jar
          printf '#!/bin/bash\njava -jar /opt/apktool.jar "$@"\n' > /opt/apktool && chmod +x /opt/apktool

      - name: Download APKs
        run: |
          curl -sL "$OFFICIAL_URL" -o /tmp/official.apk -w "OFF: HTTP %{http_code}, size: %{size_download}\n"
          curl -sL "$MODDED_URL" -o /tmp/modded.apk -w "MOD: HTTP %{http_code}, size: %{size_download}\n"

      - name: Decode
        run: |
          /opt/apktool d /tmp/official.apk -o /tmp/off -f 2>&1 | tail -1
          /opt/apktool d /tmp/modded.apk -o /tmp/mod -f 2>&1 | tail -1

      - name: Inject all missing smali dependencies
        run: |
          OFF=$(ls -d /tmp/off/smali_classes* | sort -V | tail -1)
          # Inject ALL packages that exist in modded but not in official
          # These are DPatch's dependencies and modder-added code
          for pkg in com/pandora com/bytedance/shadowhook com/bytedance/covode fe3; do
            SRC=$(find /tmp/mod -type d -path "*/$pkg" 2>/dev/null | head -1)
            if [ -n "$SRC" ]; then
              DST="$OFF/$pkg"
              mkdir -p "$DST"
              cp -r "$SRC/"* "$DST/" 2>/dev/null
              echo "ADD: $pkg ($(find "$DST" -name '*.smali' 2>/dev/null | wc -l) files)"
            fi
          done
          # Also inject dragon/read/ad/util (referenced by DPatch)
          for pkg in com/dragon/read/ad/util com/dragon/read/ad/manager; do
            SRC=$(find /tmp/mod -type d -path "*/$pkg" 2>/dev/null | head -1)
            if [ -n "$SRC" ]; then
              DST="$OFF/$pkg"
              mkdir -p "$DST"
              cp -r "$SRC/"* "$DST/" 2>/dev/null
              echo "ADD: $pkg ($(find "$DST" -name '*.smali' 2>/dev/null | wc -l) files)"
            fi
          done

      - name: Patch manifest
        run: |
          sed -i 's/android:appComponentFactory="[^"]*"/android:appComponentFactory="com.pandora.core.AppFactory"/' /tmp/off/AndroidManifest.xml
          grep appComponentFactory /tmp/off/AndroidManifest.xml

      - name: Build
        run: |
          /opt/apktool b /tmp/off -o /tmp/unsigned.apk 2>&1
          ls -lh /tmp/unsigned.apk

      - name: Sign
        if: success()
        run: |
          keytool -genkey -v -keystore /tmp/debug.keystore -alias debug \
            -keyalg RSA -keysize 2048 -validity 10000 \
            -storepass android -keypass android \
            -dname "CN=Clean,O=Clean,C=CN" 2>&1
          jarsigner -sigalg SHA1withRSA -digestalg SHA1 \
            -keystore /tmp/debug.keystore -storepass android \
            /tmp/unsigned.apk debug 2>&1 | tail -3
          mv /tmp/unsigned.apk /tmp/clean.apk
          ls -lh /tmp/clean.apk && echo "SIGNED OK"

      - name: Upload
        uses: actions/upload-artifact@v4
        with:
          name: dpatch-injected
          path: /tmp/clean.apk
          retention-days: 30

      - name: Delete old runs
        uses: Mattraks/delete-workflow-runs@v2
        with:
          retain_days: 0
          keep_minimum_runs: 5
